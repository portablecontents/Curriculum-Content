    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // DOM Elements
            const screens = { 
                start: document.getElementById('start-screen'), 
                game: document.getElementById('game-screen'), 
                highscore: document.getElementById('highscore-screen'),
                gameOver: document.getElementById('game-over-screen')
            };
            const playerInitialsInput = document.getElementById('player-initials');
            const startGameBtn = document.getElementById('start-game-btn');
            const continueGameBtn = document.getElementById('continue-game-btn');
            const viewScoresBtn = document.getElementById('view-scores-btn');
            const mainMenuBtnScores = document.getElementById('main-menu-btn-scores');
            const scoreDisplay = document.getElementById('score');
            const streakDisplay = document.getElementById('streak');
            const questionText = document.getElementById('question-text');
            const answersContainer = document.getElementById('answers-container');
            const questionCounter = document.getElementById('question-counter');
            const skipBtn = document.getElementById('skip-btn');
            const pauseGameBtn = document.getElementById('pause-game-btn');
            const endGameBtn = document.getElementById('end-game-btn');
            const highscoreList = document.getElementById('highscore-list');
            const fanfareContainer = document.getElementById('fanfare-container');
            const viewFinalScoresBtn = document.getElementById('view-final-scores-btn');

            let gameState = { playerName: 'AAA', score: 0, streak: 0, questionBank: [], currentQuestionIndex: 0 };
            let music = {}, sounds = {}, isAudioReady = false;

            async function initAudio() {
                if (isAudioReady) return;
                await Tone.start();

                const reverb = new Tone.Reverb(2).toDestination();
                reverb.wet.value = 0.3;
                const lowpass = new Tone.Filter(1000, "lowpass").connect(reverb);
                const crusher = new Tone.BitCrusher(8).connect(lowpass);
                crusher.wet.value = 0.1;

                const pianoSynth = new Tone.PolySynth(Tone.FMSynth, {
                    harmonicity: 3, modulationIndex: 1.4,
                    envelope: { attack: 0.01, decay: 0.8, sustain: 0.1, release: 1.2 },
                    modulationEnvelope: { attack: 0.05, decay: 0.3, sustain: 0, release: 0.1 }
                }).connect(crusher);
                pianoSynth.volume.value = -8;

                const bassSynth = new Tone.MonoSynth({
                    oscillator: { type: "sine" },
                    envelope: { attack: 0.01, decay: 0.2, sustain: 0.1, release: 0.4 }
                }).toDestination();
                bassSynth.volume.value = -4;
                
                sounds = {
                    start: new Tone.Synth({ oscillator: { type: "sine" }, envelope: { attack: 0.01, decay: 0.2, sustain: 0.2, release: 0.2 } }).toDestination(),
                    incorrect: new Tone.Synth({ oscillator: { type: "square" }, envelope: { attack: 0.01, decay: 0.3, sustain: 0, release: 0.1 } }).toDestination(),
                    correctFanfare: new Tone.PolySynth(Tone.Synth, { oscillator: { type: "triangle" }, envelope: { attack: 0.01, decay: 0.1, sustain: 0.1, release: 0.2 } }).toDestination(),
                };
                
                music = {
                    start: new Tone.Part((time, value) => { pianoSynth.triggerAttackRelease(value.chord, "1m", time); }, [{time: "0:0", chord: ["C4", "E4", "G4", "B4"]}, {time: "1:0", chord: ["F3", "A3", "C4", "E4"]}]).start(0),
                    game: new Tone.Part((time, value) => { pianoSynth.triggerAttackRelease(value.chord, "2n", time); bassSynth.triggerAttackRelease(value.bass, "4n", time); }, [{ time: "0:0", chord: ["D4", "F4", "A4", "C5"], bass: "D3" }, { time: "0:2", bass: "A3" }, { time: "1:0", chord: ["G4", "B4", "D5", "F5"], bass: "G3" }, { time: "1:2", bass: "D4" }, { time: "2:0", chord: ["C4", "E4", "G4", "B4"], bass: "C3" }, { time: "2:2", bass: "G3" }, { time: "3:0", chord: ["C4", "E4", "G4", "B4"], bass: "C3" }, { time: "3:2", bass: "G3" }]).start(0),
                    highscore: new Tone.Sequence((time, note) => { pianoSynth.triggerAttackRelease(note, "2n", time); }, [ "C5", "A4", "G4", "E4" ], "1n").start(0)
                };
                music.start.loop = true; music.start.loopEnd = "2m";
                music.game.loop = true; music.game.loopEnd = "4m";
                music.highscore.loop = true; music.highscore.loopEnd = "4m";

                Tone.Transport.bpm.value = 85;
                Tone.Transport.start(); isAudioReady = true; playMusicForScreen('start');
            }

            const playSound = (sound, note, duration) => { if (!isAudioReady) return; sound.triggerAttackRelease(note, duration); };
            const playFanfare = () => { if (!isAudioReady) return; const now = Tone.now(); sounds.correctFanfare.triggerAttackRelease(["C5", "E5", "G5"], "8n", now); sounds.correctFanfare.triggerAttackRelease("C6", "8n", now + 0.2); };
            const playMusicForScreen = (screenId) => { if (!isAudioReady) return; Object.values(music).forEach(m => m.mute = true); if (music[screenId]) { music[screenId].mute = false; } };

            const showScreen = (screenId) => { Object.values(screens).forEach(screen => screen.classList.add('hidden')); screens[screenId].classList.remove('hidden'); playMusicForScreen(screenId); };
            const shuffleArray = (array) => { for (let i = array.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [array[i], array[j]] = [array[j], array[i]]; } };
            const updateUI = () => { scoreDisplay.textContent = `Score: ${gameState.score}`; streakDisplay.textContent = `Streak: ${gameState.streak}`; questionCounter.textContent = `Q: ${gameState.currentQuestionIndex + 1}/${allQuestions.length}`; };

            const displayQuestion = () => {
                if (gameState.currentQuestionIndex >= gameState.questionBank.length) { 
                    endGame(true);
                    return; 
                }
                const currentQuestion = gameState.questionBank[gameState.currentQuestionIndex];
                questionText.innerHTML = `<span class='text-yellow-300'>"${currentQuestion.quote}"</span><br><br>${currentQuestion.question}`;
                answersContainer.innerHTML = '';
                const shuffledAnswers = [...currentQuestion.answers]; shuffleArray(shuffledAnswers);
                shuffledAnswers.forEach(answer => { const button = document.createElement('button'); button.textContent = answer; button.classList.add('btn', 'text-xs', 'p-3', 'w-full', 'h-full'); button.addEventListener('click', () => checkAnswer(answer, currentQuestion)); answersContainer.appendChild(button); });
                updateUI();
            };
            
            const triggerFanfare = () => {
                fanfareContainer.innerHTML = '';
                for (let i = 0; i < 20; i++) { const sparkle = document.createElement('div'); sparkle.className = 'sparkle'; const x = Math.random() * 100; const y = Math.random() * 100; sparkle.style.left = `${x}%`; sparkle.style.top = `${y}%`; const tx = (Math.random() - 0.5) * 200; const ty = (Math.random() - 0.5) * 200; sparkle.style.setProperty('--tx', `${tx}px`); sparkle.style.setProperty('--ty', `${ty}px`); fanfareContainer.appendChild(sparkle); }
                setTimeout(() => fanfareContainer.innerHTML = '', 1000);
            };
            
            const advanceToNextQuestion = () => {
                gameState.currentQuestionIndex++;
                displayQuestion();
                saveGame();
            };

            const checkAnswer = (selectedAnswer, currentQuestion) => {
                const answerButtons = answersContainer.querySelectorAll('button');
                answerButtons.forEach(btn => btn.disabled = true);
                let isCorrect = selectedAnswer === currentQuestion.correctAnswer;
                
                if (isCorrect) {
                    gameState.score += 100 + (gameState.streak * 10);
                    gameState.streak++;
                    playFanfare();
                    triggerFanfare();
                    [...answerButtons].find(btn => btn.textContent === selectedAnswer).classList.add('correct');
                } else {
                    gameState.score = Math.max(0, gameState.score - 50);
                    gameState.streak = 0;
                    playSound(sounds.incorrect, "C3", "4n");
                    [...answerButtons].find(btn => btn.textContent === selectedAnswer).classList.add('incorrect');
                }
                [...answerButtons].find(btn => btn.textContent === currentQuestion.correctAnswer).classList.add('correct');
                
                updateUI();
                
                setTimeout(() => {
                    advanceToNextQuestion();
                }, 2000);
            };

            const startGame = (isNewGame) => {
                if (!isAudioReady) initAudio();
                playSound(sounds.start, "C4", "8n");
                if (isNewGame) {
                    localStorage.removeItem('litHunterSaveData');
                    gameState.score = 0;
                    gameState.streak = 0;
                    gameState.currentQuestionIndex = 0;
                    gameState.questionBank = [...allQuestions];
                    shuffleArray(gameState.questionBank);
                }
                gameState.playerName = playerInitialsInput.value.toUpperCase().padEnd(3, ' ') || 'AAA';
                displayQuestion();
                showScreen('game');
                saveGame();
            };

            const endGame = (completed = false) => {
                saveHighScore(gameState.playerName, gameState.score);
                localStorage.removeItem('litHunterSaveData');
                checkForSavedGame();
                if (completed) {
                    showScreen('gameOver');
                } else {
                    displayHighScores();
                    showScreen('highscore');
                }
            };

            const saveGame = () => localStorage.setItem('litHunterSaveData', JSON.stringify(gameState));
            const loadGame = () => { const savedData = JSON.parse(localStorage.getItem('litHunterSaveData')); if (savedData) { if (!isAudioReady) initAudio(); gameState = savedData; startGame(false); } };
            const checkForSavedGame = () => { continueGameBtn.classList.toggle('hidden', !localStorage.getItem('litHunterSaveData')); };
            
            const getHighScores = () => JSON.parse(localStorage.getItem('litHunterHighScores')) || [];
            const saveHighScore = (name, score) => { const scores = getHighScores(); scores.push({ name, score }); scores.sort((a, b) => b.score - a.score); localStorage.setItem('litHunterHighScores', JSON.stringify(scores.slice(0, 10))); };
            const displayHighScores = () => { const scores = getHighScores(); highscoreList.innerHTML = scores.length === 0 ? '<li>NO SCORES YET</li>' : scores.map((s, i) => `<li><span class="text-yellow-300">${i + 1}. ${s.name}</span> --- <span class="text-cyan-300">${s.score}</span></li>`).join(''); };

            // Event Listeners
            startGameBtn.addEventListener('click', () => startGame(true));
            continueGameBtn.addEventListener('click', loadGame);
            viewScoresBtn.addEventListener('click', () => { if (!isAudioReady) initAudio(); displayHighScores(); showScreen('highscore'); });
            mainMenuBtnScores.addEventListener('click', () => { checkForSavedGame(); showScreen('start'); });
            pauseGameBtn.addEventListener('click', () => { saveGame(); checkForSavedGame(); showScreen('start'); });
            endGameBtn.addEventListener('click', () => endGame(false));
            skipBtn.addEventListener('click', () => {
                gameState.score = Math.max(0, gameState.score - 10);
                gameState.streak = 0;
                updateUI();
                advanceToNextQuestion();
            });
            viewFinalScoresBtn.addEventListener('click', () => {
                displayHighScores();
                showScreen('highscore');
            });
            
            // Initial state
            checkForSavedGame(); showScreen('start');
        });
    </script>
</body>
</html>
